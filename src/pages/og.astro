---
// Lienzo 1200×630 para la imagen social. scripts/og.mjs lo captura a public/og.png.
// ?icono → lienzo cuadrado con el glifo, para los iconos de app.
import '../styles/sitio.css';
import Logo from '../components/Logo.astro';
import { textos } from '../lib/textos.js';
import { sitio } from '../sitio.js';
const t = textos(sitio.idiomas[0]);
---
<!doctype html>
<html lang={sitio.idiomas[0]} data-theme="light">
  <head><meta charset="utf-8" /><meta name="robots" content="noindex" /><title>og</title>
    <style is:global>
      body { margin: 0; }
      .og { width: 1200px; height: 630px; display: grid; place-content: center; justify-items: center; gap: 18px; background: var(--paper); position: relative; overflow: hidden; }
      .og .logo { font-size: 200px; line-height: 1; }
      .og p { font: 400 40px/1.15 var(--font-sans); letter-spacing: -.03em; text-align: center; max-width: 900px; }
      .og::after { content: ''; position: absolute; inset: auto -10% -60% -10%; height: 70%; background: radial-gradient(closest-side, color-mix(in srgb, var(--accent) 22%, transparent), transparent); }
      .icono { width: 512px; height: 512px; display: none; place-items: center; background: var(--paper); border-radius: 112px; }
      .icono .glifo { font-size: 520px; }
      html.modo-icono .og { display: none; } html.modo-icono .icono { display: grid; }
    </style>
    <script is:inline>if (location.search.includes('icono')) document.documentElement.classList.add('modo-icono');</script>
  </head>
  <body>
    <div class="og"><Logo /><p set:html={`${t.heroe.linea1}<br>${t.heroe.linea2}`} /></div>
    <div class="icono"><span class="logo"><span class="glifo"><i></i></span></span></div>
  </body>
</html>
