---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import { textos } from '../lib/textos.js';
const { lang } = Astro.props;
const k = textos(lang).marca;
---
<Base lang={lang} meta={k.meta} camino="/marca">
  <div class="pagina contenedor">
    <header class="marca-hero" style="display:grid;gap:18px;padding-bottom:44px">
      <Logo />
      <span class="eyebrow">{k.etiqueta}</span>
      <h1 class="h1" style="font-size:clamp(36px,5vw,56px)">{k.titulo}</h1>
      <p class="texto">{k.lead}</p>
      <div><button class="btn primary" type="button" data-copiar={k.prompt} data-copiado={k.copiado}><span data-etiqueta>{k.botonPrompt}</span></button></div>
    </header>
    <section class="bloque"><h2 class="h3">{k.nombre.titulo}</h2><p class="texto" set:html={k.nombre.texto} /></section>
    <section class="bloque">
      <h2 class="h3">{k.logos.titulo}</h2>
      <div class="lienzos">
        <div class="lienzo claro"><div class="area"><Logo /></div><div class="pie">{k.logos.claro}</div></div>
        <div class="lienzo oscuro"><div class="area"><Logo /></div><div class="pie">{k.logos.oscuro}</div></div>
      </div>
    </section>
    <section class="bloque">
      <h2 class="h3">{k.colores.titulo}</h2><p class="texto">{k.colores.texto}</p>
      <div class="colores">
        {k.colores.lista.map((c) => (
          <button class="color" type="button" data-copiar={c.hex} data-copiado={k.copiado}>
            <span class="muestra" style={`background:${c.hex}`}></span><b>{c.nombre}</b><small>{c.uso}</small><code data-etiqueta>{c.hex}</code>
          </button>
        ))}
      </div>
    </section>
    <section class="bloque" style="grid-template-columns:1fr 1fr;gap:32px">
      <div style="display:grid;gap:12px"><h2 class="h3">{k.tipo.titulo}</h2><p class="texto" set:html={k.tipo.texto} /><p style="font:600 64px/1 var(--font-sans);letter-spacing:-.04em">Aa <em>Aa</em> <code style="font-size:28px">Aa</code></p></div>
      <div style="display:grid;gap:12px;align-content:start"><h2 class="h3">{k.uso.titulo}</h2><ul role="list" style="display:grid;gap:8px">{k.uso.reglas.map((r) => <li class="check acento">{r}</li>)}</ul></div>
    </section>
  </div>
</Base>
