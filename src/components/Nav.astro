---
import Logo from './Logo.astro';
import { textos } from '../lib/textos.js';
import { rutaIdioma } from '../lib/ruta.js';
const { lang, camino } = Astro.props;
const t = textos(lang);
---
<header class="site-nav">
  <a class="site-brand" href={rutaIdioma(lang, '/')} aria-label="Inicio">
    <Logo clase="logo-mini" />
  </a>
  <nav class="site-pill" aria-label="Principal">
    {t.nav.enlaces.map((e) => <a href={rutaIdioma(lang, e.href)}>{e.texto}</a>)}
    <div class="theme" role="radiogroup" aria-label={t.nav.tema.grupo}>
      <button type="button" role="radio" aria-checked="true" data-t="system" aria-label={t.nav.tema.sistema}><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></svg></button>
      <button type="button" role="radio" aria-checked="false" data-t="light" aria-label={t.nav.tema.claro}><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg></button>
      <button type="button" role="radio" aria-checked="false" data-t="dark" aria-label={t.nav.tema.oscuro}><svg viewBox="0 0 24 24"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z"/></svg></button>
    </div>
    <a class="btn primary sm" href={rutaIdioma(lang, t.nav.cta.href)}><span>{t.nav.cta.texto}</span></a>
  </nav>
</header>
