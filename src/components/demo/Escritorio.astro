---
// Escritorio simulado: fondo, barra de menús y dock. Las ventanas van en el slot.
// dock: [{ clase: 'd-editor', icono: '✍️', nombre: 'Editor' }]
const { app = 'Finder', menus = 'Archivo  Edición  Ver  Ventana', hora = 'mar 28 oct  9:41', dock = [], clase = '' } = Astro.props;
---
<div class={`demo ${clase}`} aria-hidden="true">
  <div class="fondo"></div>
  <div class="menubar">
    <span class="izq">
      <svg width="13" height="15" viewBox="0 0 17 20"><path fill="currentColor" d="M14.1 10.6c0-2.6 2.1-3.8 2.2-3.9-1.2-1.8-3.1-2-3.7-2-1.6-.2-3.1.9-3.9.9-.8 0-2-.9-3.4-.9-1.7 0-3.3 1-4.2 2.6-1.8 3.1-.5 7.7 1.3 10.2.9 1.2 1.9 2.6 3.2 2.6 1.3-.1 1.8-.8 3.3-.8s2 .8 3.4.8c1.4 0 2.3-1.3 3.1-2.5 1-1.4 1.4-2.8 1.4-2.9 0 0-2.7-1-2.7-4.1ZM11.6 3c.7-.9 1.2-2 1-3.1-1 0-2.2.7-2.9 1.5-.6.7-1.2 1.9-1 3 1.1.1 2.2-.6 2.9-1.4Z"/></svg>
      <b class="app">{app}</b><span class="menus">{menus}</span>
    </span>
    <span class="der"><slot name="barra" /><span class="reloj">{hora}</span></span>
  </div>
  <slot />
  {dock.length > 0 && (
    <div class="dock">{dock.map((d) => <span class={`icono ${d.clase ?? ''}`} title={d.nombre}>{d.icono}</span>)}</div>
  )}
</div>
